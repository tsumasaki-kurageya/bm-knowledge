---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { repository } from '../../scripts/site-config.mjs';
const review = Astro.locals.starlightRoute.entry.data.review;
const issue = review && `${repository}/issues/new?${new URLSearchParams({
  title: `${review.id}：レビュー`,
  body: `対象：${review.source}\n\n見出し：\n\n修正内容・理由：\n`,
})}`;
---
<span id={Astro.locals.starlightRoute.entry.data.legacyTitle} aria-hidden="true"></span>
<Default />
{review && <aside class="review-meta" aria-label="文書情報">
  <strong>{review.id}</strong>
  <span>状態: {review.status}</span>
  <span>信頼度: {review.confidence}</span>
  <span>確認日: {review.last_reviewed}</span>
  <a href={`${repository}/blob/main/${review.source}`}>Markdown原文</a>
  <a href={issue}>修正を提案</a>
</aside>}
<script>
  import '../scripts/diagrams';
</script>
